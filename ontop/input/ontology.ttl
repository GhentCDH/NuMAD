@prefix :     <http://numad.ugent.be/resource/> .
@prefix nmd:  <http://numad.ugent.be/ontology#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix nmo:  <http://nomisma.org/ontology#> .
@prefix schema: <http://schema.org/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

nmd:
    a               owl:Ontology ;
    rdfs:label      "NuMAD Ontology"@en ;
    rdfs:comment    "Ontology for NuMAD"@en ;
    dct:creator     "NuMAD Project" ;
    dct:description "An ontology for representing extra concepts for coin finds not yet present in nomisma"@en .


##############
# CLASSES
##############
nmd:Identifier
    a               owl:Class ;
    rdfs:subClassOf schema:Person ;
    rdfs:label      "Identifier"@en ;
    rdfs:comment    "A person who identified one or multiple coins"@en .

nmd:LocalAdminUnit
    a          owl:Class ;
    rdfs:label "Local Admin Unit"@en .

nmd:Authority
    a               owl:Class ;
    rdfs:subClassOf schema:Person ;
    rdfs:label      "Authority"@en ;
    rdfs:comment    "We use this class to define rulers in NuMAD since nomisma has no specific class for rulers or authorities"@en .

nmd:FindSpot
    a owl:Class ;
    rdfs:label "Describes a spot where there have been finds"@en ;
    rdfs:comment "Again nomisma has no specific class to formally describe find spots."@en .

nmd:ObjectClassification
    a          owl:Class ;
    rdfs:label "Object Classification"@en .

nmd:ObjectSubclass
    a          owl:Class ;
    rdfs:label "Object Subclass"@en .

nmd:State
    a          owl:Class ;
    rdfs:label "Preservation state"@en .

nmd:StatedAuthority
    a          owl:Class ;
    rdfs:label "Stated Authority"@en .

nmd:Issuer
    a          owl:Class ;
    rdfs:label "Issuer"@en .

nmd:CoinType
    a          owl:Class ;
    rdfs:label "Coin Type"@en .

nmd:ReecePeriod
    a owl:Class ;
    rdfs:label "Reece Period"@en .


#############
# PROPERTIES
#############
nmd:hasIdentifier
    a            owl:ObjectProperty ;
    rdfs:domain  nmo:Coin ;
    rdfs:range   nmd:Identifier ;
    rdfs:label   "Has identifier"@en ;
    rdfs:comment "The person who identified the numismatic object"@en .

nmd:hasLocalAdminUnit
    a           owl:ObjectProperty ;
    rdfs:domain nmo:Find ;
    rdfs:range  nmd:LocalAdminUnit ;
    rdfs:label  "Has local admin unit"@en .

nmd:hasDiscoveryType
    a owl:DatatypeProperty  ;
    rdfs:domain nmo:Find ;
    rdfs:range xsd:string ;
    rdfs:label "Has discovery type"@en .

nmd:hasDepositionType
    a owl:DatatypeProperty  ;
    rdfs:domain nmo:Find ;
    rdfs:range xsd:string ;
    rdfs:label "Has deposition type"@en .

nmd:hasFindSpotToponym
    a owl:DatatypeProperty ;
    rdfs:subPropertyOf schema:name, rdfs:label ;
    rdfs:domain nmd:FindSpot ;
    rdfs:range xsd:string ;
    rdfs:label "Has findspot toponym"@en .

nmd:hasSiteClassification
    a owl:DatatypeProperty ;
    rdfs:domain nmd:FindSpot ;
    rdfs:range xsd:string ;
    rdfs:label "Has site classification"@en .

nmd:hasArchaeologicalStructure
    a owl:DatatypeProperty ;
    rdfs:domain nmd:FindSpot ;
    rdfs:range xsd:string ;
    rdfs:label "Has archaeological structure"@en .

nmd:hasObjectClassification
    a            owl:ObjectProperty ;
    rdfs:domain  nmo:Coin ;
    rdfs:range   nmd:ObjectClassification ;
    rdfs:label   "Has object classification"@en .

nmd:hasObjectSubclass
    a            owl:ObjectProperty ;
    rdfs:domain  nmo:Coin ;
    rdfs:range   nmd:ObjectSubclass ;
    rdfs:label   "Has object subclass"@en .

nmd:hasState
    a            owl:ObjectProperty ;
    rdfs:domain  nmo:Coin ;
    rdfs:range   nmd:State ;
    rdfs:label   "Has state"@en .

nmd:hasCoinType
    a            owl:ObjectProperty ;
    rdfs:domain  nmo:Coin ;
    rdfs:range   nmd:CoinType ;
    rdfs:label   "Has coin type"@en .

nmd:hasReferenceWork
    a            owl:DatatypeProperty ;
    rdfs:domain  nmo:Coin ;
    rdfs:range   xsd:string ;
    rdfs:label   "Has reference work"@en .

nmd:hasDenominationDetail
    a            owl:DatatypeProperty ;
    rdfs:domain  nmo:Coin ;
    rdfs:range   xsd:string ;
    rdfs:label   "Has denomination detail"@en .

nmd:hasCountermark
    a            owl:DatatypeProperty ;
    rdfs:domain  nmo:Coin ;
    rdfs:range   xsd:string ;
    rdfs:label   "Has countermark"@en .

nmd:hasObverseDesign
    a            owl:DatatypeProperty ;
    rdfs:domain  nmo:Coin ;
    rdfs:range   xsd:string ;
    rdfs:label   "Has obverse design"@en .

nmd:hasObverseLegend
    a            owl:DatatypeProperty ;
    rdfs:domain  nmo:Coin ;
    rdfs:range   xsd:string ;
    rdfs:label   "Has obverse legend"@en .

nmd:hasReverseDesign
    a            owl:DatatypeProperty ;
    rdfs:domain  nmo:Coin ;
    rdfs:range   xsd:string ;
    rdfs:label   "Has reverse design"@en .

nmd:hasReverseLegend
    a            owl:DatatypeProperty ;
    rdfs:domain  nmo:Coin ;
    rdfs:range   xsd:string ;
    rdfs:label   "Has reverse legend"@en .

nmd:hasReecePeriod
    a owl:ObjectProperty ;
    rdfs:domain nmo:Coin ;
    rdfs:range nmd:ReecePeriod ;
    rdfs:label "From Reece Period"@en .

nmd:hasDuration
    a owl:DatatypeProperty ;
    rdfs:domain nmd:ReecePeriod ;
    rdfs:range xsd:int ;
    rdfs:label "Has duration"@en .

nmd:hasLallemand_dates
    a owl:DatatypeProperty ;
    rdfs:domain nmd:ReecePeriod ;
    rdfs:range xsd:string ;
    rdfs:label "Lallemand dates"@en .

nmd:hasLallemand
    a owl:DatatypeProperty ;
    rdfs:domain nmd:ReecePeriod ;
    rdfs:range xsd:string ;
    rdfs:label "Lallemand identifier"@en .

nmd:hasReeceSequence
    a owl:DatatypeProperty ;
    rdfs:domain nmd:ReecePeriod ;
    rdfs:range xsd:string ;
    rdfs:label "Reece sequence"@en .

nmd:hasReeceNames
    a owl:DatatypeProperty ;
    rdfs:domain nmd:ReecePeriod ;
    rdfs:range xsd:string ;
    rdfs:label "Reece names"@en .

nmd:hasReeceDates
    a owl:DatatypeProperty ;
    rdfs:domain nmd:ReecePeriod ;
    rdfs:range xsd:string ;
    rdfs:label "Reece dates"@en .