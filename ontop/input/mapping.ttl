# NOTE: this file is currently a simple example at most
@prefix :       <http://numad.ugent.be/resource/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix nmd:    <http://numad.ugent.be/ontology#> .
@prefix org:    <http://www.w3.org/ns/org#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rov:    <http://www.w3.org/ns/regorg#> .
@prefix rr:     <http://www.w3.org/ns/r2rml#> .
@prefix schema: <http://schema.org/> .
@prefix vcard:  <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix nmo:    <http://nomisma.org/ontology#> .
@prefix geo:  <http://www.opengis.net/ont/geosparql#> .

##############
# COINS
##############
:COIN
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery
                                    """SELECT id, year_start, year_end, weight, diameter, die_axis, original_id,
                                              reference_work, denomination_detail, countermark,
                                              obverse_design, obverse_legend, reverse_design, reverse_legend
                                       FROM coin""" ] ;
    rr:subjectMap         [ rr:template "http://numad.ugent.be/resource/coin/{id}" ;
                            rr:class    nmo:Coin ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
                            rr:objectMap [ rr:column   "original_id" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nmo:hasStartDate ;
                            rr:objectMap [ rr:column   "year_start" ;
                                           rr:datatype xsd:int ] ] ;
    rr:predicateObjectMap [ rr:predicate nmo:hasEndDate ;
                            rr:objectMap [ rr:column   "year_end" ;
                                           rr:datatype xsd:int ] ] ;
    rr:predicateObjectMap [ rr:predicate nmo:hasWeight ;
                            rr:objectMap [ rr:column   "weight" ;
                                           rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate nmo:hasDiameter ;
                            rr:objectMap [ rr:column   "diameter" ;
                                           rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate nmo:hasAxis ;
                            rr:objectMap [ rr:column   "die_axis" ;
                                           rr:datatype xsd:int ] ] ;
    rr:predicateObjectMap [ rr:predicate nmd:hasReferenceWork ;
                            rr:objectMap [ rr:column   "reference_work" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nmd:hasDenominationDetail ;
                            rr:objectMap [ rr:column   "denomination_detail" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nmd:hasCountermark ;
                            rr:objectMap [ rr:column   "countermark" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nmd:hasObverseDesign ;
                            rr:objectMap [ rr:column   "obverse_design" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nmd:hasObverseLegend ;
                            rr:objectMap [ rr:column   "obverse_legend" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nmd:hasReverseDesign ;
                            rr:objectMap [ rr:column   "reverse_design" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nmd:hasReverseLegend ;
                            rr:objectMap [ rr:column   "reverse_legend" ;
                                           rr:datatype xsd:string ] ] .


:COIN-IDENTIFIER
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """
        SELECT id, identifier_id FROM coin
    """ ] ;
    rr:subjectMap         [ rr:template "http://numad.ugent.be/resource/coin/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate nmd:hasIdentifier ;
                            rr:objectMap [ rr:template "http://numad.ugent.be/resource/identifier/{identifier_id}" ] ] .

:COIN-FIND
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """SELECT id, find_id FROM coin""" ] ;
    rr:subjectMap         [ rr:template "http://numad.ugent.be/resource/coin/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate nmo:hasFindContext ;
                            rr:objectMap [ rr:template "http://numad.ugent.be/resource/find/{find_id}" ] ] .

:COIN-SAME-AS
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """
        SELECT id, online_reference FROM coin
        WHERE online_reference IS NOT NULL AND online_reference <> ''
    """ ] ;
    rr:subjectMap         [ rr:template "http://numad.ugent.be/resource/coin/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate owl:sameAs ;
                            rr:objectMap [ rr:column   "online_reference" ;
                                           rr:termType rr:IRI ] ] .

:COIN-DENOMINATION
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """
        SELECT id, denomination_id FROM coin
    """ ] ;
    rr:subjectMap         [ rr:template "http://numad.ugent.be/resource/coin/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate nmo:hasDenomination ;
                            rr:objectMap [ rr:template
                                                   "http://numad.ugent.be/resource/denomination/{denomination_id}" ] ] .

:COIN-RULER
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """SELECT coin_id, ruler_id FROM coinruler""" ] ;
    rr:subjectMap         [ rr:template "http://numad.ugent.be/resource/coin/{coin_id}" ] ;
    rr:predicateObjectMap [ rr:predicate nmo:hasAuthority ;
                            rr:objectMap [ rr:template "http://numad.ugent.be/resource/ruler/{ruler_id}" ] ] .

:COIN-MINT
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """SELECT id, mint_id FROM coin""" ] ;
    rr:subjectMap         [ rr:template "http://numad.ugent.be/resource/coin/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate nmo:hasMint ;
                            rr:objectMap [ rr:template "http://numad.ugent.be/resource/mint/{mint_id}" ] ] .

:COIN-MATERIAL
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """SELECT id, material_id FROM coin""" ] ;
    rr:subjectMap         [ rr:template "http://numad.ugent.be/resource/coin/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate nmo:hasMaterial ;
                            rr:objectMap [ rr:template "http://numad.ugent.be/resource/material/{material_id}" ] ] .


#########
# FINDS
#########
:FIND
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery
                                    """SELECT id, find_spot_id, local_admin_unit_id, discovery_type, deposition_type, find_year_start, find_year_end, CAST(id AS TEXT) AS find_label FROM find""" ] ;
    rr:subjectMap         [ rr:template "http://numad.ugent.be/resource/find/{id}" ;
                            rr:class    nmo:Find ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
                            rr:objectMap [ rr:column   "find_label" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nmo:hasStartDate ;
                            rr:objectMap [ rr:column   "find_year_start" ;
                                           rr:datatype xsd:int ] ] ;
    rr:predicateObjectMap [ rr:predicate nmo:hasEndDate ;
                            rr:objectMap [ rr:column   "find_year_end" ;
                                           rr:datatype xsd:int ] ] ;
    rr:predicateObjectMap [ rr:predicate nmo:hasFindSpot ;
                            rr:objectMap [ rr:template "http://numad.ugent.be/resource/findspot/{find_spot_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate nmd:hasDiscoveryType ;
                            rr:objectMap [ rr:column   "discovery_type" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nmd:hasDepositionType ;
                            rr:objectMap [ rr:column   "deposition_type" ;
                                           rr:datatype xsd:string ] ] .

:FIND-LOCAL-ADMIN-UNIT
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """SELECT id, local_admin_unit_id FROM find""" ] ;
    rr:subjectMap         [ rr:template "http://numad.ugent.be/resource/find/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate nmd:hasLocalAdminUnit ;
                            rr:objectMap [ rr:template
                                                   "http://numad.ugent.be/resource/localadminunit/{local_admin_unit_id}" ] ] .


:FINDSPOT
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery
                                    """SELECT id, name, site_classification, archaeological_structure FROM findspot""" ] ;
    rr:subjectMap         [ rr:template "http://numad.ugent.be/resource/findspot/{id}" ;
                            rr:class    nmd:FindSpot ] ;
    rr:predicateObjectMap [ rr:predicate nmd:hasFindSpotToponym ;
                            rr:objectMap [ rr:column   "name" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
                            rr:objectMap [ rr:column   "name" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nmd:hasSiteClassification ;
                            rr:objectMap [ rr:column   "site_classification" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nmd:hasArchaeologicalStructure ;
                            rr:objectMap [ rr:column   "archaeological_structure" ;
                                           rr:datatype xsd:string ] ] .

################
# IDENTIFIERS
################
:IDENTIFIER
    a               rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """
        SELECT id FROM identifier
    """ ] ;
    rr:subjectMap   [ rr:template "http://numad.ugent.be/resource/identifier/{id}" ;
                      rr:class    nmd:Identifier ] .

:IDENTIFIER-PROPERTIES
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """
        SELECT id, name FROM identifier
    """ ] ;
    rr:subjectMap         [ rr:template "http://numad.ugent.be/resource/identifier/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
                            rr:objectMap [ rr:column   "name" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate schema:name ;
                            rr:objectMap [ rr:column   "name" ;
                                           rr:datatype xsd:string ] ] .

#################
# Denominations
#################
:DENOMINATION
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """
        SELECT id, name, nomisma_uri FROM denomination
    """ ] ;
    rr:subjectMap         [ rr:template "http://numad.ugent.be/resource/denomination/{id}" ;
                            rr:class    nmo:Denomination ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
                            rr:objectMap [ rr:column   "name" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate owl:sameAs ;
                            rr:objectMap [ rr:column   "nomisma_uri" ;
                                           rr:termType rr:IRI ] ] .

###########
# RULERS
###########
:RULER
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """SELECT id, name, nomisma_uri, start_date, end_date FROM ruler""" ] ;
    rr:subjectMap         [ rr:template "http://numad.ugent.be/resource/ruler/{id}" ;
                            rr:class    nmd:Authority ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
                            rr:objectMap [ rr:column   "name" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate owl:sameAs ;
                            rr:objectMap [ rr:column   "nomisma_uri" ;
                                           rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate nmo:hasStartDate ;
                            rr:objectMap [ rr:column   "start_date" ;
                                           rr:dataType xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate nmo:hasEndDate ;
                            rr:objectMap [ rr:column   "end_date" ;
                                           rr:dataType xsd:string ] ] .

#########
# MINTS
#########
:MINT
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """
        SELECT
            id, name, nomisma_uri
        FROM mint
    """ ] ;
    rr:subjectMap         [ rr:template "http://numad.ugent.be/resource/mint/{id}" ;
                            rr:class    nmo:Mint ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
                            rr:objectMap [ rr:column   "name" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate owl:sameAs ;
                            rr:objectMap [ rr:column   "nomisma_uri" ;
                                           rr:termType rr:IRI ] ] .

:MINT-MINT-LOCATION
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """
        SELECT
            id
        FROM mint m
        WHERE m.latitude IS NOT NULL AND m.longitude IS NOT NULL
    """ ] ;
    rr:subjectMap         [ rr:template "http://numad.ugent.be/resource/mint/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate schema:geo ;
                            rr:objectMap [ rr:template "http://numad.ugent.be/resource/mint/{id}/geo" ] ] .

:MINT-LOCATION
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """
        SELECT
            id,
            m.latitude as lat,
            m.longitude as long
        FROM mint m
        WHERE m.latitude IS NOT NULL AND m.longitude IS NOT NULL
    """ ] ;
    rr:subjectMap         [ rr:template "http://numad.ugent.be/resource/mint/{id}/geo" ;
                            rr:class    schema:GeoCoordinates ] ;
    rr:predicateObjectMap [ rr:predicate schema:latitude ;
                            rr:objectMap [ rr:column   "lat" ;
                                           rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate schema:longitude ;
                            rr:objectMap [ rr:column   "long" ;
                                           rr:datatype xsd:decimal ] ] .

##############
# MATERIALS
##############
:MATERIAL
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """
        SELECT
            id, name, label, nomisma_uri
        FROM material
    """ ] ;
    rr:subjectMap         [ rr:template "http://numad.ugent.be/resource/material/{id}" ;
                            rr:class    nmo:Material ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
                            rr:objectMap [ rr:column   "name" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate skos:prefLabel ;
                            rr:objectMap [ rr:column   "label" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate owl:sameAs ;
                            rr:objectMap [ rr:column   "nomisma_uri" ;
                                           rr:termType rr:IRI ] ] .

####################
# LOCAL ADMIN UNITS
####################
:LOCAL-ADMIN-UNIT
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """
        SELECT id, name FROM localadminunit
    """ ] ;
    rr:subjectMap         [ rr:template "http://numad.ugent.be/resource/localadminunit/{id}" ;
                            rr:class    nmd:LocalAdminUnit ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
                            rr:objectMap [ rr:column   "name" ;
                                           rr:datatype xsd:string ] ] .

:LOCAL-ADMIN-UNIT-LOCATION-LINK
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """
        SELECT
            id
        FROM localadminunit a
        WHERE a.latitude IS NOT NULL AND a.longitude IS NOT NULL
    """ ] ;
    rr:subjectMap         [ rr:template "http://numad.ugent.be/resource/localadminunit/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate schema:geo ;
                            rr:objectMap [ rr:template "http://numad.ugent.be/resource/localadminunit/{id}/geo" ] ] .


:LOCAL-ADMIN-UNIT-LOCATION
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """
        SELECT
            id,
            a.latitude as lat,
            a.longitude as long
        FROM localadminunit a
        WHERE a.latitude IS NOT NULL AND a.longitude IS NOT NULL
    """ ] ;
    rr:subjectMap         [ rr:template "http://numad.ugent.be/resource/localadminunit/{id}/geo" ;
                            rr:class    schema:GeoCoordinates ] ;
    rr:predicateObjectMap [ rr:predicate schema:latitude ;
                            rr:objectMap [ rr:column   "lat" ;
                                           rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate schema:longitude ;
                            rr:objectMap [ rr:column   "long" ;
                                           rr:datatype xsd:decimal ] ] .

:LOCAL-ADMIN-UNIT-WKT
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """
        SELECT
            id,
            ST_SetSRID(ST_MakePoint(longitude, latitude), 4326) AS geom
        FROM localadminunit
        WHERE latitude IS NOT NULL AND longitude IS NOT NULL
    """ ] ;
    rr:subjectMap         [ rr:template "http://numad.ugent.be/resource/localadminunit/{id}/geo" ] ;
    rr:predicateObjectMap [ rr:predicate geo:asWKT ;
                            rr:objectMap [ rr:column   "geom" ;
                                           rr:datatype geo:wktLiteral ] ] .

