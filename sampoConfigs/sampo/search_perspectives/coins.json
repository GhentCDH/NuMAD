{
    "id": "coins",
    "endpoint": {
        "url": "",
        "useAuth": false,
        "prefixesFile": "prefixes.js",
        "defaultSparql": true
    },
    "generalQueries": {
        "facetResultSetQuery": "facetResultSetQueryOntop",
        "facetValuesQuery": "facetValuesQueryOntop"
    },
    "sparqlQueriesFile": "coins.js",
    "baseURI": "http://numad.ugent.be/resource",
    "URITemplate": "<BASE_URI>/coin/<LOCAL_ID>",
    "facetClass": "nmo:Coin",
    "frontPageImage": "main_page/tetricus_coin.png",
    "searchMode": "faceted-search",
    "enableDynamicLanguageChange": false,
    "defaultActiveFacets": [],
    "defaultTab": "table",
    "defaultInstancePageTab": "table",
    "resultClasses": {
        "coins": {
            "paginatedResultsConfig": {
                "tabID": 0,
                "component": "ResultTable",
                "tabPath": "table",
                "tabIcon": "CalendarViewDay",
                "propertiesQueryBlock": "coinProperties",
                "pagesize": 100,
                "sortBy": null,
                "sortDirection": null
            },
            "instanceConfig": {
                "propertiesQueryBlock": "coinProperties",
                "instancePageResultClasses": {
                    "instancePageTable": {
                        "tabID": 0,
                        "component": "InstancePageTable",
                        "tabPath": "table",
                        "tabIcon": "CalendarViewDay"
                    }
                }
            }
        },
        "findsPlaces": {
            "tabID": 1,
            "tabPath": "map",
            "tabIcon": "AddLocation",
            "component": "LeafletMap",
            "showInstanceCountInClusters": false,
            "showExternalLayers": true,
            "customMapControl": true,
            "sparqlQuery": "coinPlaces",
            "filterTarget": "id",
            "facetClass": "coins",
            "resultMapper": "mapPlaces",
            "instanceConfig": {
                "propertiesQueryBlock": "coinProperties",
                "createPopUpContent": "createPopUpContentDefault"
            },
            "customTilesLayer": {
                "type": "pmtiles",
                "inConfig": true,
                "url": "maps/world.pmtiles",
                "maxZoom": 14,
                "minZoom": 8
            }
        },
        "findsPlacesHeatmap": {
            "tabID": 2,
            "tabPath": "heatmap",
            "tabIcon": "BubbleChart",
            "component": "Deck",
            "layerType": "heatmapLayer",
            "sparqlQuery": "coinPlaces",
            "facetClass": "coins",
            "filterTarget": "id",
            "resultMapper": "mapPlaces",
            "customTilesLayer": {
                "type": "pmtiles",
                "inConfig": true,
                "url": "maps/world.pmtiles"
            }
        },
        "mintsPlacesHeatmap": {
            "tabID": 3,
            "tabPath": "mintsheatmap",
            "tabIcon": "BubbleChart",
            "component": "Deck",
            "layerType": "heatmapLayer",
            "sparqlQuery": "mintPlaces",
            "facetClass": "coins",
            "filterTarget": "id",
            "resultMapper": "mapPlaces",
            "customTilesLayer": {
                "type": "pmtiles",
                "inConfig": true,
                "url": "maps/world.pmtiles"
            }
        },
        "coinsMigrations": {
            "tabID": 4,
            "component": "CustomComponent",
            "componentName": "MigrationsMapWithRoads",
            "tabPath": "migrations",
            "tabIcon": "Redo",
            "sparqlQuery": "migrations",
            "facetClass": "coins",
            "filterTarget": "coin",
            "resultMapper": "makeObjectList",
            "layerType": "arcLayer",
            "arcWidthVariable": "instanceCountScaled",
            "instanceVariable": "coin",
            "showTooltips": false,
            "postprocess": {
                "func": "linearScale",
                "config": {
                    "variable": "instanceCount",
                    "minAllowed": 2,
                    "maxAllowed": 20
                }
            },
            "customTilesLayer": {
                "type": "pmtiles",
                "inConfig": true,
                "url": "maps/world.pmtiles"
            },
            "roadsGeoJson": {
                "inConfig": true,
                "url": "maps/itinere_roads_4326.geojson"
            }
        },
        "coinsMigrationsDialog": {
            "sparqlQuery": "migrationsDialog",
            "filterTarget": "id",
            "resultMapper": "makeObjectList"
        },
        "aoristicCoins": {
            "tabID": 5,
            "component": "ApexCharts",
            "doNotRenderOnMount": true,
            "tabPath": "aoristic_chart",
            "tabIcon": "ShowChart",
            "facetClass": "coins",
            "dropdownForResultClasses": true,
            "defaultResultClass": "coinsByAoristicTime10",
            "resultClasses": {
                "coinsByAoristicTime10": {
                    "sparqlQuery": "coinsByTimeSpansQuery10",
                    "filterTarget": "id",
                    "resultMapper": "mapAoristicChart",
                    "sliceVisibilityThreshold": false,
                    "dropdownForChartTypes": false,
                    "chartTypes": [
                        {
                            "id": "bar",
                            "createChartData": "createApexBarChartAoristictData"
                        }
                    ]
                },
                "coinsByAoristicTime20": {
                    "sparqlQuery": "coinsByTimeSpansQuery20",
                    "filterTarget": "id",
                    "resultMapper": "mapAoristicChart",
                    "sliceVisibilityThreshold": false,
                    "dropdownForChartTypes": false,
                    "chartTypes": [
                        {
                            "id": "bar",
                            "createChartData": "createApexBarChartAoristictData"
                        }
                    ]
                },
                "coinsByAoristicTime50": {
                    "sparqlQuery": "coinsByTimeSpansQuery50",
                    "filterTarget": "id",
                    "resultMapper": "mapAoristicChart",
                    "sliceVisibilityThreshold": false,
                    "dropdownForChartTypes": false,
                    "chartTypes": [
                        {
                            "id": "bar",
                            "createChartData": "createApexBarChartAoristictData"
                        }
                    ]
                },
                "coinsByAoristicTime100": {
                    "sparqlQuery": "coinsByTimeSpansQuery100",
                    "filterTarget": "id",
                    "resultMapper": "mapAoristicChart",
                    "sliceVisibilityThreshold": false,
                    "dropdownForChartTypes": false,
                    "chartTypes": [
                        {
                            "id": "bar",
                            "createChartData": "createApexBarChartAoristictData"
                        }
                    ]
                },
                "coinCountByRuler": {
                    "sparqlQuery": "coinCountByRulerQuery",
                    "filterTarget": "coin",
                    "resultMapper": "mapPieChart",
                    "sliceVisibilityThreshold": false,
                    "dropdownForChartTypes": false,
                    "seriesTitle": "Number of coins",
                    "xaxisTitle": "Ruler",
                    "yaxisTitle": "Number of coins",
                    "chartTypes": [
                        {
                            "id": "bar",
                            "createChartData": "createApexBarChartData"
                        }
                    ]
                },
                "coinCountByRulerRelative": {
                    "sparqlQuery": "coinCountByRulerRelativeQuery",
                    "filterTarget": "coin",
                    "resultMapper": "mapPieChartFloat",
                    "sliceVisibilityThreshold": false,
                    "dropdownForChartTypes": false,
                    "seriesTitle": "Coins per year of reign",
                    "xaxisTitle": "Ruler",
                    "yaxisTitle": "Coins per year of reign",
                    "chartTypes": [
                        {
                            "id": "bar",
                            "createChartData": "createApexBarChartData"
                        }
                    ]
                },
                "coinCountByReecePeriod": {
                    "sparqlQuery": "coinCountByReecePeriodQuery",
                    "filterTarget": "coin",
                    "resultMapper": "mapPieChart",
                    "sliceVisibilityThreshold": 0.01,
                    "dropdownForChartTypes": false,
                    "seriesTitle": "Number of coins",
                    "xaxisTitle": "Reece period",
                    "yaxisTitle": "Number of coins",
                    "chartTypes": [
                        {
                            "id": "bar",
                            "createChartData": "createApexBarChartData"
                        }
                    ]
                }
            }
        }
